{
  "name": "lkm-on-vscode",
  "displayName": "LKM Blog on VS Code",
  "description": "把 LKM 平台的 blog 系列用 Git 克隆到本地编辑与推送",
  "version": "0.0.1",
  "publisher": "lkm",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/LKM-AHZ/LKM-on-VSCode.git"
  },
  "author": "LKM",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "lkm.cloneBlog",
        "title": "LKM: Clone Blog"
      },
      {
        "command": "lkm.pull",
        "title": "LKM: Pull"
      },
      {
        "command": "lkm.push",
        "title": "LKM: Push"
      },
      {
        "command": "lkm.addAccount",
        "title": "LKM: Add Account"
      },
      {
        "command": "lkm.switchAccount",
        "title": "LKM: Switch Account"
      },
      {
        "command": "lkm.removeAccount",
        "title": "LKM: Remove Account"
      },
      {
        "command": "lkm.createSeries",
        "title": "LKM: Create Series"
      },
      {
        "command": "lkm.deleteSeries",
        "title": "LKM: Delete Series"
      },
      {
        "command": "lkm.toggleStar",
        "title": "LKM: Toggle Star"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lkm-series",
          "title": "LKM Series",
          "icon": "resources/lkm.svg"
        }
      ]
    },
    "views": {
      "lkm-series": [
        {
          "id": "lkm.seriesTree",
          "name": "LKM Series"
        }
      ]
    },
    "configuration": {
      "title": "LKM",
      "properties": {
        "lkm.serverUrl": {
          "type": "string",
          "default": "",
          "description": "LKM 后端地址，如 https://lkm-ahz.ltd"
        },
        "lkm.sync.pullIntervalMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "自动同步定时拉取的间隔分钟数。"
        },
        "lkm.sync.pullOnFocus": {
          "type": "boolean",
          "default": true,
          "description": "窗口获得焦点时是否自动拉取。"
        },
        "lkm.autoPush.enabled": {
          "type": "boolean",
          "default": false,
          "description": "（暂未生效）自动保存推送（add -A + commit + push）。默认关闭；git add/commit/push 能力尚未实现，开启后保存文件不会产生任何 git 操作。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "vscode:prepublish": "pnpm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
